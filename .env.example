# Required: Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: ElevenLabs API key for higher-quality TTS.
# If set, TTS defaults to ElevenLabs; otherwise it uses offline pyttsx3.
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=Rachel

# --- Spotify (Phase 2) — required for music control ---
# Create an app at https://developer.spotify.com/dashboard
# SPOTIPY_CLIENT_ID=...
# SPOTIPY_CLIENT_SECRET=...
# Must EXACTLY match a Redirect URI added in your Spotify app settings:
# SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Optional tuning (sensible defaults are in config.py) ---
# WAKE_THRESHOLD=0.5
# WHISPER_MODEL=base        # tiny / base / small / medium
# VAD_AGGRESSIVENESS=2      # 0 (lenient) .. 3 (strict)
# SILENCE_TIMEOUT_MS=800
# CLAUDE_MODEL=claude-sonnet-4-6
# TTS_ENGINE=pyttsx3        # pyttsx3 or elevenlabs
